# Local demo. Generate two different values with python -c 'from secrets import token_urlsafe; print(token_urlsafe(32))'.
CUSTOMER_TOKEN=
OPERATOR_TOKEN=

GUARDRAIL_TARGET=127.0.0.1:50051
GUARDRAIL_TIMEOUT_SECONDS=0.5
MAX_INFLIGHT_REQUESTS=32
DATA_DIR=.data
ACTIVE_POLICY_VERSION=v2

# mock or bedrock. The mock runs without cloud credentials.
MODEL_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Prefer AWS_PROFILE locally or an IAM Task Role on AWS.
# AWS_PROFILE=
# AWS_BEARER_TOKEN_BEDROCK=
# Optional temporary credentials. Omit when using an AWS profile or task role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

API_BIND=127.0.0.1:50052
GUARDRAIL_BIND=127.0.0.1:50051
